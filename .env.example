# Salin file ini menjadi .env lalu isi dengan nilai dari
# Supabase Dashboard -> Project Settings -> API
#
# ATURAN KEAMANAN:
# - Gunakan hanya URL project dan anon/publishable key.
# - JANGAN PERNAH menaruh SUPABASE_SERVICE_ROLE_KEY (service-role key)
#   di aplikasi mobile ini. Service-role key hanya untuk backend/server.
# - File .env tidak boleh masuk ke Git.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
